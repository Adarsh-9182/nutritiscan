{
  "expo": {
    "name": "NutritiScan",
    "slug": "nutritiscan",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/nutritiscan-icon.png",
    "scheme": "nutritiscan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.adarsh.nutritiscan"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#05080a",
        "foregroundImage": "./assets/images/nutritiscan-icon.png",
        "backgroundImage": "./assets/images/nutritiscan-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.adarsh.nutritiscan",
      "versionCode": 3
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/nutritiscan-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05080a",
          "image": "./assets/images/nutritiscan-splash.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#05080a"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "NutritiScan uses the camera to scan meals and estimate their nutrition."
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "NutritiScan uses the camera to read product barcodes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "NutritiScan records a voice question only when you tap record. You review the transcript before sending.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#05080a"
  }
}
