# Copy to .env and fill in from your Supabase project settings (Settings → API).
# These are safe to ship in the client bundle — RLS protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# The Anthropic API key is NOT set here. It lives server-side only:
#   npx supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
